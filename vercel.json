{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "createdAt": "Jan 20, 2026",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "functions": {
    "src/app/**/*": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}